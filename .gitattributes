# Language detection for GitHub Linguist
*.py linguist-language=Python
*.sql linguist-language=SQL
*.yml linguist-detectable
*.md linguist-documentation

# Ensure dbt SQL models are counted as code, not vendored
dbt_project/models/**/*.sql linguist-vendored=false
dbt_project/tests/**/*.sql linguist-vendored=false
dbt_project/macros/**/*.sql linguist-vendored=false

# Evidence pages are documentation
evidence/pages/*.md linguist-documentation
