# Companies House API key (free, register at https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=your_api_key_here

# Paths
DUCKDB_PATH=data/charity_ledger.duckdb
RAW_DATA_PATH=data/raw

# Azure Data Lake Storage Gen2
ADLS_STORAGE_ACCOUNT=your_storage_account
ADLS_CONTAINER=charity-data
ADLS_CREDENTIAL=your_access_key_or_leave_empty_for_azure_cli

# Amazon S3
S3_BUCKET=your-bucket-name
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Snowflake
SNOWFLAKE_ACCOUNT=your_account.eu-west-2.aws
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=CHARITY_DATA
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYST
